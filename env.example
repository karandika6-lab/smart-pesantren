# =============================================
# SMART PESANTREN - Environment Configuration
# =============================================
# Copy this file to .env.local and fill in your values

# Supabase Configuration
# Get these from: https://supabase.com/dashboard -> Your Project -> Settings -> API
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here

# Service Role Key (KEEP SECRET - Never expose in client-side code)
# Get from: Dashboard -> Settings -> API -> service_role (reveal)
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# =============================================
# NOTES:
# - NEXT_PUBLIC_* variables are exposed to the browser
# - SUPABASE_SERVICE_ROLE_KEY is server-side only
# - Use Anon Key (JWT format: eyJ...) NOT publishable key (sb_...)
# =============================================
